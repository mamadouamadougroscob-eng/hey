-- ============================ LIFECYCLE ============================
local function resetBellyState()
    emergencyBellyCleanup()
    isNomming = false
    isDigesting = false
    nomModel = nil
end

local function onCharacter(character)
    resetBellyState()
    stopHipSpread()
    stopSelectMode()
    appliedScale = 1.0
    task.wait(0.3)
    local targetScale = getPlayerScale(currentBodyGrowth)
    if math.abs(targetScale - 1.0) > 0.01 then
        setCharacterScale(character, targetScale)
    end
    if thiccified then
        removeClothing(character)
        task.wait(0.05)
        buildAll(character)
    end
end

if player.Character then onCharacter(player.Character) end
player.CharacterAdded:Connect(onCharacter)
makeGUI()
