local function launchSkulls(character, count)
    if not character or not character.Parent then return end
    if not CONFIG.skulls.enabled then return end
    if count <= 0 then return end

    for i = 1, count do
        task.delay((i - 1) * 0.09, function()
            if not character.Parent then return end
            local head = character:FindFirstChild("Head")
            if not head then return end

            local skull = createSkullPart()
            skull.Parent = workspace
            skull.CFrame = head.CFrame * CFrame.new(0, -0.5, -0.8)

            local velocity = head.CFrame.LookVector * (CONFIG.skulls.speed + math.random() * 6)
            velocity = velocity + Vector3.new(0, CONFIG.skulls.upBias + math.random() * 4, 0)
            velocity = velocity + Vector3.new(
                (math.random() - 0.5) * CONFIG.skulls.spread,
                0,
                (math.random() - 0.5) * CONFIG.skulls.spread
            )
            local spin = Vector3.new(
                (math.random() - 0.5) * 20,
                (math.random() - 0.5) * 20,
                (math.random() - 0.5) * 20
            )

            local lifetime = CONFIG.skulls.lifetime
            local startTime = os.clock()

            task.spawn(function()
                while skull.Parent do
                    local dt = RunService.Heartbeat:Wait()
                    local elapsed = os.clock() - startTime
                    if elapsed > lifetime then break end

                    velocity = velocity + Vector3.new(0, -40 * dt, 0)
                    skull.CFrame = skull.CFrame + velocity * dt
                    skull.CFrame = skull.CFrame * CFrame.Angles(spin.X * dt, spin.Y * dt, spin.Z * dt)

                    if elapsed > lifetime - 0.5 then
                        local a = (elapsed - (lifetime - 0.5)) / 0.5
                        for _, p in pairs(skull:GetChildren()) do
                            if p:IsA("BasePart") then p.Transparency = a end
                        end
                    end
                end
                if skull.Parent then skull:Destroy() end
            end)
        end)
    end
end

