    return nil
end

local function applyLockedHighlight(obj)
    clearLockedHighlight()
    local gain = computeLevelGain(obj)
    selectedModel = obj

    local hl = Instance.new("Highlight")
    hl.Name = "EatTargetHighlight"
    hl.Adornee = obj
    hl.FillColor = CONFIG.nom.selectMode.fillColor
    hl.FillTransparency = CONFIG.nom.selectMode.fillTransparency
    hl.OutlineColor = CONFIG.nom.selectMode.outlineColor
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.Occluded
    hl.Parent = obj
    lockedHighlight = hl

    local adornee = findAnyBasePart(obj)
    if adornee then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "EatTargetLabel"
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
        billboard.AlwaysOnTop = true
        billboard.Adornee = adornee
        billboard.Parent = obj

        local text = Instance.new("TextLabel")
        text.Size = UDim2.new(1, 0, 1, 0)
        text.BackgroundTransparency = 1
        text.TextColor3 = Color3.fromRGB(255, 220, 120)
        text.Font = Enum.Font.SourceSansBold
        text.TextScaled = true
        text.TextStrokeTransparency = 0.3
        text.Text = string.format("EAT: +%d belly", gain)
        text.Parent = billboard
        tierLabel = billboard
    end
end

local function startSelectMode()
    if selectModeOn then return end
    selectModeOn = true

    hoverConn = RunService.RenderStepped:Connect(function()
        if not selectModeOn then return end
        if lockedHighlight then return end

        local mouse = UserInputService:GetMouseLocation()
        local target = findEatTargetAtScreen(mouse.X, mouse.Y)

        if target and target ~= hoverHighlight then
            clearHoverHighlight()
            local hl = Instance.new("Highlight")
            hl.Name = "EatHoverHighlight"
            hl.Adornee = target
            hl.FillColor = Color3.fromRGB(200, 200, 255)
            hl.FillTransparency = 0.8
            hl.OutlineColor = Color3.fromRGB(150, 150, 220)
            hl.OutlineTransparency = 0.3
            hl.DepthMode = Enum.HighlightDepthMode.Occluded
            hl.Parent = target
            hoverHighlight = hl
        elseif not target then
            clearHoverHighlight()
        end
    end)

    if clickConn then clickConn:Disconnect() end
    clickConn = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if not selectModeOn then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
           and input.UserInputType ~= Enum.UserInputType.Touch then return end

        local target
        if input.UserInputType == Enum.UserInputType.Touch then
            target = findEatTargetAtScreen(input.Position.X, input.Position.Y)
        else
            local mouse = UserInputService:GetMouseLocation()
            target = findEatTargetAtScreen(mouse.X, mouse.Y)
        end

        if target then
            applyLockedHighlight(target)
        else
            clearLockedHighlight()
            selectedModel = nil
        end
    end)
end

local function stopSelectMode()
    selectModeOn = false
    clearHoverHighlight()
    clearLockedHighlight()
    selectedModel = nil
    if clickConn then clickConn:Disconnect(); clickConn = nil end
    if hoverConn then hoverConn:Disconnect(); hoverConn = nil end
end

-- ============================ EAT ANYTHING — Animation ============================
local function eatSelectedModel(character)
    local obj = selectedModel
    if not obj or not obj.Parent then return false end

    isNomming = true
    clearLockedHighlight()
    clearHoverHighlight()
    selectedModel = nil

    local head = character:FindFirstChild("Head")
    if not head then isNomming = false; return true end
    local sc = getHeadColor(character)

    local gain = computeLevelGain(obj)

    -- Anchor every part
    local allParts = {}
    for _, p in pairs(obj:GetDescendants()) do
        if p:IsA("BasePart") then
            p.Anchored = true
            table.insert(allParts, p)
        end
    end
    -- If obj is itself a BasePart, GetDescendants might miss it
    if obj:IsA("BasePart") and not table.find(allParts, obj) then
        obj.Anchored = true
        table.insert(allParts, obj)
    end
    if #allParts == 0 then isNomming = false; return true end

    local startPivot = obj:GetPivot()
    local aboveHeadPos = head.Position + Vector3.new(0, CONFIG.nom.selectMode.riseHeight, 0)
    local mouthPos = head.Position + Vector3.new(0, -0.4, -0.6)
    local midPos = startPivot.Position:Lerp(aboveHeadPos, 0.5) + Vector3.new(0, 8, 0)

    -- PHASE 1: arc upward
    local riseDur = CONFIG.nom.selectMode.riseDuration
    local riseT = 0
    while riseT < riseDur do
        local dt = RunService.Heartbeat:Wait()
        if not character.Parent or not obj.Parent then break end
        riseT = riseT + dt
        local a = math.clamp(riseT / riseDur, 0, 1)
        local e = 1 - (1 - a) * (1 - a)
        local p0 = startPivot.Position
        local p1 = midPos
        local p2 = aboveHeadPos
        local u = e
        local pos = (1 - u) * (1 - u) * p0 + 2 * (1 - u) * u * p1 + u * u * p2
        local rot = CFrame.Angles(0, math.rad(e * 360), 0)
        local newCF = CFrame.new(pos) * rot
        pcall(function() obj:PivotTo(newCF) end)
    end

    -- PHASE 2: drop into mouth
    if obj.Parent and character.Parent then
        local fallStart = obj:GetPivot()
        local fallDur = CONFIG.nom.selectMode.fallDuration
        local fallT = 0
        while fallT < fallDur do
            local dt = RunService.Heartbeat:Wait()
            if not character.Parent or not obj.Parent then break end
            fallT = fallT + dt
            local a = math.clamp(fallT / fallDur, 0, 1)
            a = a * a
            local pos = fallStart.Position:Lerp(mouthPos, a)
            pcall(function() obj:PivotTo(CFrame.new(pos)) end)
        end
    end

    -- PHASE 3: fade
    if obj.Parent then
        local shrinkDur = CONFIG.nom.selectMode.shrinkDuration
        local shrinkT = 0
        while shrinkT < shrinkDur do
            local dt = RunService.Heartbeat:Wait()
            if not obj.Parent then break end
            shrinkT = shrinkT + dt
            local a = math.clamp(shrinkT / shrinkDur, 0, 1)
            for _, p in pairs(allParts) do
                if p.Parent then p.Transparency = math.min(1, p.Transparency + a * 0.9) end
            end
            RunService.Heartbeat:Wait()
        end
    end

    if obj.Parent then obj:Destroy() end

    if character.Parent then
        applyBellyGain(character, sc, gain)
        if burpEmitter and burpEmitter.Parent then
            burpEmitter:Emit(math.min(60, 12 + gain * 4))
        end
        if gain >= 5 and head then
            local thud = Instance.new("Sound")
            thud.SoundId = "rbxassetid://138587268"
            thud.Volume = 3; thud.Pitch = 0.6
            thud.Parent = head
            thud:Play()
            Debris:AddItem(thud, 2)
        end
    end

    isNomming = false
    return true
end

-- ============================ DIGEST ============================
local function emergencyBellyCleanup()
    if bulgeConn then bulgeConn:Disconnect(); bulgeConn = nil end
    stopBurpLoop()
    for _, state in ipairs(activeBulges) do
        if state.part and state.part.Parent then state.part:Destroy() end
    end
    activeBulges = {}
    for _, p in pairs(nomTempParts) do
        if p and p.Parent then p:Destroy() end
    end
    nomTempParts = {}
    local filtered = {}
    for _, entry in pairs(jiggleParts) do
        if entry.group ~= "belly" then
            table.insert(filtered, entry)
        end
    end
    jiggleParts = filtered
    activeBellyLayers = {}
    nomLevel = 0
    bellyActive = false
end

local function runDigest(character)
    if not character or not character.Parent then return end
    if not bellyActive or isDigesting or isNomming then return end
    isDigesting = true
    stopBurpLoop()

    local ok, err = pcall(function()
        if bulgeConn then bulgeConn:Disconnect(); bulgeConn = nil end
        for _, state in ipairs(activeBulges) do
            if state.part and state.part.Parent then state.part:Destroy() end
        end
        activeBulges = {}

        local gain = CONFIG.digest.growPerLevel * nomLevel
        local oldPS = getPlayerScale(currentBodyGrowth)
        local newGrowth = currentBodyGrowth + gain
        local newPS = getPlayerScale(newGrowth)
        local newAssetScale = getAssetScale(newGrowth)
        currentBodyGrowth = newGrowth

        local dur = CONFIG.digest.duration
        local info = TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)

        task.spawn(function()
            local startT = os.clock()
            while os.clock() - startT < dur do
                if not character.Parent then return end
                local a = math.clamp((os.clock() - startT) / dur, 0, 1)
                local interp = oldPS + (newPS - oldPS) * a
                setCharacterScale(character, interp)
                RunService.Heartbeat:Wait()
            end
            if character.Parent then
                setCharacterScale(character, newPS)
            end
        end)

        for _, layer in ipairs(activeBellyLayers) do
            if layer.mesh and layer.mesh.Parent then
                TweenService:Create(layer.mesh, info, {Scale = Vector3.new(0.05, 0.05, 0.05)}):Play()
            end
        end

        for _, ref in ipairs(bodyMeshRefs) do
            if ref.mesh and ref.mesh.Parent then
                local newScale = ref.baseScale * newAssetScale
                TweenService:Create(ref.mesh, info, {Scale = newScale}):Play()
            end
            if ref.weld and ref.weld.Parent and ref.baseRawPos then
                local newPos = ref.baseRawPos * newPS * newAssetScale
                TweenService:Create(ref.weld, info, {C0 = CFrame.new(newPos)}):Play()
            end
        end

        local startTime = os.clock()
        while os.clock() - startTime < dur + 0.15 do
            if not character.Parent then break end
            RunService.Heartbeat:Wait()
        end

        for _, entry in pairs(jiggleParts) do
            if entry.weld and entry.weld.Parent then
                entry.baseC0 = entry.weld.C0
            end
        end

        task.wait(CONFIG.digest.finalBurpDelay)

        if character.Parent then
            if not burpEmitter or not burpEmitter.Parent then
                setupBurpObjects(character)
                startBurpTiltConnection()
            end
            triggerBurp(character)

            -- SKULL BURST ON DIGEST
            local skullCount = math.min(
                CONFIG.skulls.maxCount,
                CONFIG.skulls.baseCount + math.floor(nomLevel * CONFIG.skulls.extraPerTwoLevels / 2)
            )
            launchSkulls(character, skullCount)

            task.wait(0.8)
        end
    end)

    if not ok then warn("[Digest] "..tostring(err)) end
    emergencyBellyCleanup()
    isDigesting = false
end

-- ============================ RESET ============================
local function resetEverything()
    local character = player.Character
    if not character or not character.Parent then return end
    currentBodyGrowth = 1.0
    setCharacterScale(character, 1.0)
    appliedScale = 1.0
    task.wait(0.1)
    if thiccified then
        buildAll(character)
    end
end

-- ============================ TOGGLE ============================
local function toggleThiccify()
    local character = player.Character
    if not character or not character.Parent then return end
    thiccified = not thiccified
    if thiccified then
        removeClothing(character)
        task.wait(0.05)
        buildAll(character)
    else
        clearAll(character)
        restoreClothing()
        stopHipSpread()
        setCharacterScale(character, 1.0)
        appliedScale = 1.0
        currentBodyGrowth = 1.0
    end
    return thiccified
end

