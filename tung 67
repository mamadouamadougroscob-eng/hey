local function startBurpTiltConnection()
    if burpTiltConn then burpTiltConn:Disconnect() end
    burpTiltConn = RunService.RenderStepped:Connect(function()
        if burpTiltAmt <= 0 then return end
        local character = player.Character
        if not character then return end
        local neck = findNeckMotor(character)
        if not neck then return end
        if not neck:GetAttribute("BurpBaseCX") then
            neck:SetAttribute("BurpBaseCX", neck.C0.X)
            neck:SetAttribute("BurpBaseCY", neck.C0.Y)
            neck:SetAttribute("BurpBaseCZ", neck.C0.Z)
        end
        local bx = neck:GetAttribute("BurpBaseCX")
        local by = neck:GetAttribute("BurpBaseCY")
        local bz = neck:GetAttribute("BurpBaseCZ")
        if bx then
            local tilt = CFrame.Angles(math.rad(CONFIG.burp.headTiltDeg * burpTiltAmt), 0, 0)
            neck.C0 = CFrame.new(bx, by, bz) * tilt
        end
    end)
end

local function triggerBurp(character)
    if not character or not character.Parent then return end
    if not burpEmitter or not burpEmitter.Parent then return end
    if not burpSound or not burpSound.Parent then return end
    burpEmitter:Emit(CONFIG.burp.particleCount)
    burpSound.Pitch = (0.9 + math.random() * 0.3) / math.max(1, appliedScale * 0.7)
    burpSound:Play()
    task.spawn(function()
        local neck = findNeckMotor(character)
        if neck and not neck:GetAttribute("BurpBaseCX") then
            neck:SetAttribute("BurpBaseCX", neck.C0.X)
            neck:SetAttribute("BurpBaseCY", neck.C0.Y)
            neck:SetAttribute("BurpBaseCZ", neck.C0.Z)
        end
        local dur = CONFIG.burp.headTiltTime
        local t0 = os.clock()
        while os.clock() - t0 < dur do
            if not neck or not neck.Parent then burpTiltAmt = 0; return end
            local elapsed = os.clock() - t0
            local a = math.clamp(elapsed / dur, 0, 1)
            burpTiltAmt = (a < 0.5) and (a * 2) or ((1 - a) * 2)
            RunService.RenderStepped:Wait()
        end
        burpTiltAmt = 0
        if neck and neck.Parent then
            local bx = neck:GetAttribute("BurpBaseCX")
            local by = neck:GetAttribute("BurpBaseCY")
            local bz = neck:GetAttribute("BurpBaseCZ")
            if bx then neck.C0 = CFrame.new(bx, by, bz) end
        end
    end)
end

local function startBurpLoop(character)
    if burpConn then burpConn:Disconnect() end
    setupBurpObjects(character)
    startBurpTiltConnection()
    local timeAccum = 0
    local nextInterval = math.random(1.5, 3.0)
    burpConn = RunService.Heartbeat:Connect(function(dt)
        if not bellyActive or not character.Parent or isDigesting then
            if burpConn then burpConn:Disconnect() end
            burpConn = nil
            return
        end
        timeAccum = timeAccum + dt
        if timeAccum >= nextInterval then
            timeAccum = 0
            triggerBurp(character)
            local t = math.clamp((nomLevel - 1) / 8, 0, 1)
            local minI = CONFIG.burp.minInterval + (CONFIG.burp.minAtMax - CONFIG.burp.minInterval) * t
            local maxI = CONFIG.burp.maxInterval + (CONFIG.burp.maxAtMax - CONFIG.burp.maxInterval) * t
            nextInterval = minI + math.random() * (maxI - minI)
        end
    end)
end

local function stopBurpLoop()
    if burpConn then burpConn:Disconnect(); burpConn = nil end
    if burpTiltConn then burpTiltConn:Disconnect(); burpTiltConn = nil end
    if burpAttachment and burpAttachment.Parent then burpAttachment:Destroy() end
    if burpSound and burpSound.Parent then burpSound:Destroy() end
    burpAttachment = nil; burpEmitter = nil; burpSound = nil
    burpTiltAmt = 0
end

