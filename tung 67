local function buildBreast(ut, sc)
    for _, side in ipairs({-1, 1}) do
        local sfx = (side > 0) and "R" or "L"
        for i, layer in ipairs(CONFIG.breast.layers) do
            makeEllipsoid("BreastLayer"..i..sfx, ut, sc,
                Vector3.new(layer.scale[1], layer.scale[2], layer.scale[3]),
                Vector3.new(layer.pos[1]*side, layer.pos[2], layer.pos[3]),
                ut, "breast"..sfx)
        end
        local a = CONFIG.breast.areola
        makeEllipsoid("Areola"..sfx, ut, BrickColor.new(a.color),
            Vector3.new(a.scale[1],a.scale[2],a.scale[3]),
            Vector3.new(a.pos[1]*side,a.pos[2],a.pos[3]),
            ut, "breast"..sfx)
