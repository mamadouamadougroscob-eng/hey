local function getHeadColor(character)
    local head = character:FindFirstChild("Head")
    if head then return head.BrickColor end
    local bc = character:FindFirstChild("BodyColors")
    if bc then return bc.HeadColor end
    return BrickColor.new("Medium orange")
end

local function makeEllipsoid(name, parent, color, baseScale, rawPos, weldTo, jiggleGroup)
    local p = Instance.new("Part")
    p.Name = name; p.Size = Vector3.new(1,1,1); p.BrickColor = color
    p.Material = Enum.Material.SmoothPlastic
    p.Anchored = false; p.CanCollide = false; p.Massless = true
    p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent

    local assetScale = getAssetScale(currentBodyGrowth)
    local playerScale = getPlayerScale(currentBodyGrowth)

    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Sphere
    mesh.Scale = baseScale * assetScale
    mesh.Parent = p

    local scaledPos = rawPos * playerScale * assetScale
    local cf = weldTo.CFrame * CFrame.new(scaledPos)
    p.CFrame = cf

    local w = Instance.new("Weld")
    w.Part0 = weldTo; w.Part1 = p
    w.C0 = CFrame.new(scaledPos); w.C1 = CFrame.new()
    w.Parent = p

    table.insert(createdParts, p)
    if jiggleGroup then
        table.insert(jiggleParts, {part = p, weld = w, baseC0 = w.C0, group = jiggleGroup})
    end
    table.insert(bodyMeshRefs, {
        mesh = mesh, baseScale = baseScale, weld = w, baseRawPos = rawPos,
    })
    return p
end

local function removeClothing(character)
    removedClothing = {}
    for _, child in pairs(character:GetChildren()) do
        if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") then
            table.insert(removedClothing, {instance = child, parent = character})
            child.Parent = nil
        end
    end
end

local function restoreClothing()
    for _, entry in pairs(removedClothing) do
        if entry.instance and entry.parent then entry.instance.Parent = entry.parent end
    end
    removedClothing = {}
end

local function recolorRig(character)
    recoloredParts = {}
    local hc = getHeadColor(character)
    for _, name in ipairs(CONFIG.RIG_PARTS) do
        local part = character:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            table.insert(recoloredParts, {part = part, originalColor = part.BrickColor})
            part.BrickColor = hc
        end
    end
end

local function restoreRigColors()
    for _, entry in pairs(recoloredParts) do
        if entry.part and entry.part.Parent then entry.part.BrickColor = entry.originalColor end
    end
    recoloredParts = {}
end

