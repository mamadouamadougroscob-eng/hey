        makeEllipsoid("Nipple"..sfx, ut, BrickColor.new(n.color),
            Vector3.new(n.scale[1],n.scale[2],n.scale[3]),
            Vector3.new(n.pos[1]*side,n.pos[2],n.pos[3]),
            ut, "breast"..sfx)
