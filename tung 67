    mp("RightArm", Vector3.new(1,2,1), skin, CFrame.new(1.3, -0.2, -0.2) * CFrame.Angles(0, 0, math.rad(25)))
    mp("LeftLeg", Vector3.new(1,2,1), pants, CFrame.new(-0.5, -1.5, -0.8) * CFrame.Angles(math.rad(-45), 0, 0))
    mp("RightLeg", Vector3.new(1,2,1), pants, CFrame.new(0.5, -1.5, -0.8) * CFrame.Angles(math.rad(-45), 0, 0))
