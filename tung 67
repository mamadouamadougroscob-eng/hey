-- ============================ GROWTH MATH ============================
local function getAssetScale(growth)
    local t = CONFIG.growth.threshold
    if growth <= t then return growth end
    return t + (growth - t) * CONFIG.growth.assetDamping
end

local function getPlayerScale(growth)
    local base = CONFIG.growth.basePlayerScale
    local t = CONFIG.growth.threshold
    if growth <= t then return base end
    return base + (growth - t) * CONFIG.growth.playerScalePerGrowth
end

local function getBellyPlayerScale(ps)
    return 1 + (ps - 1) * CONFIG.nom.bellyScaleDamp
end

local function getBellyGrowthXYZ(level)
    local t = math.max(0, level - 1)
    local early = math.min(t, CONFIG.nom.earlyLevels)
    local mid   = math.max(0, math.min(t - CONFIG.nom.earlyLevels, CONFIG.nom.midLevels))
    local late  = math.max(0, t - CONFIG.nom.earlyLevels - CONFIG.nom.midLevels)

    local gx = 1 + early * CONFIG.nom.earlyRateX + mid * CONFIG.nom.midRateX + late * CONFIG.nom.lateRateX
    local gy = 1 + early * CONFIG.nom.earlyRateY + mid * CONFIG.nom.midRateY + late * CONFIG.nom.lateRateY
    local gz = 1 + early * CONFIG.nom.earlyRateZ + mid * CONFIG.nom.midRateZ + late * CONFIG.nom.lateRateZ
    return gx, gy, gz
end

-- ============================ CHARACTER SCALE ============================
local function setCharacterScale(character, scale)
    if not character or not character.Parent then return end
    if math.abs(scale - appliedScale) < 0.005 then return end

    local ok = pcall(function()
        character:ScaleTo(scale)
    end)

    if ok then
        appliedScale = scale
    else
        local hum = character:FindFirstChildOfClass("Humanoid")
        if hum then
            local h = hum:FindFirstChild("BodyHeightScale")
            local w = hum:FindFirstChild("BodyWidthScale")
            local d = hum:FindFirstChild("BodyDepthScale")
            local hd = hum:FindFirstChild("HeadScale")
            if h and h:IsA("NumberValue") then h.Value = scale end
            if w and w:IsA("NumberValue") then w.Value = scale end
            if d and d:IsA("NumberValue") then d.Value = scale end
            if hd and hd:IsA("NumberValue") then hd.Value = scale end
            appliedScale = scale
        end
    end
end

local function startHipSpread(character)
    if hipSpreadConn then hipSpreadConn:Disconnect() end
    hipSpreadConn = RunService.Heartbeat:Connect(function()
        if not character.Parent then
            if hipSpreadConn then hipSpreadConn:Disconnect() end
            hipSpreadConn = nil
            return
        end
        local lt = character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso")
        if not lt then return end
        local rh = lt:FindFirstChild("RightHip")
        local lh = lt:FindFirstChild("LeftHip")
        if not (rh and lh) then return end

        local ps = getPlayerScale(currentBodyGrowth)
        local extra = CONFIG.hips.extraSpread * ps
        local rBase = rh.C0
        local rRot = rBase - rBase.Position
        rh.C0 = CFrame.new(rBase.Position + Vector3.new(extra, 0, 0)) * rRot
        local lBase = lh.C0
        local lRot = lBase - lBase.Position
        lh.C0 = CFrame.new(lBase.Position + Vector3.new(-extra, 0, 0)) * lRot
    end)
end

local function stopHipSpread()
    if hipSpreadConn then hipSpreadConn:Disconnect(); hipSpreadConn = nil end
end

