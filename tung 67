local function setDummyCFrame(model, cf)
    if not model or not model.PrimaryPart then return end
    local head = model.PrimaryPart
    local delta = cf * head.CFrame:Inverse()
    for _, p in pairs(model:GetChildren()) do
        if p:IsA("BasePart") then p.CFrame = delta * p.CFrame end
    end
end

local function setDummyTransparency(model, alpha)
    if not model then return end
    for _, p in pairs(model:GetDescendants()) do
        if p:IsA("BasePart") then p.Transparency = alpha end
    end
end

local function setDummyScale(model, factor)
    if not model then return end
    for _, p in pairs(model:GetChildren()) do
        if p:IsA("BasePart") then
            if not p:GetAttribute("BaseSize") then p:SetAttribute("BaseSize", p.Size) end
            p.Size = p:GetAttribute("BaseSize") * factor
        end
    end
end

-- ============================ NOM BELLY ============================
local function computeBellyTargetsForLevel(level)
    local gx, gy, gz = getBellyGrowthXYZ(level)
    local ps = getPlayerScale(currentBodyGrowth)
    local psBelly = getBellyPlayerScale(ps)
    local sagLevel = math.min(math.max(0, level - 1), CONFIG.nom.yHangCapLevels)

    local result = {}
    for i, def in ipairs(NOM_BELLY_LAYER_DEFS) do
        local ns = Vector3.new(
            def.base.X * gx * psBelly,
            def.base.Y * gy * psBelly,
            def.base.Z * gz * psBelly
        )
        local backZWorld = def.backZ * ps
        local centerZ = backZWorld - ns.Z / 2
        local sagY = -sagLevel * def.yHang * CONFIG.nom.yHangPerLevel * psBelly
        local centerY = def.baseC0.Y * psBelly + sagY
        local centerX = def.baseC0.X * psBelly
        result[i] = {c0 = Vector3.new(centerX, centerY, centerZ), scale = ns}
    end
    return result
end

