local function addBulgesForCurrentLevel(character, sc)
    if not activeBellyLayers[1] then return end
    local bm = activeBellyLayers[1].part
    local target = math.min(
        CONFIG.nom.bulgeBaseCount + (nomLevel - 1) * CONFIG.nom.bulgePerLevel,
        CONFIG.nom.bulgeMaxCount
    )
    for i = 1, target - #activeBulges do createBulge(character, sc, bm) end
end

local function startBulgeLoop(character)
    if bulgeConn then bulgeConn:Disconnect() end
    bulgeConn = RunService.Heartbeat:Connect(function()
        if not character.Parent or not bellyActive or isDigesting then return end
        if not activeBellyLayers[1] then return end
        local bmm = activeBellyLayers[1].mesh
        if not bmm or not bmm.Parent then return end
        local now = os.clock()
        local hx = bmm.Scale.X * 0.5
        local hy = bmm.Scale.Y * 0.5
        local hz = bmm.Scale.Z * 0.5
        local pc = 0
        for _, s in ipairs(activeBulges) do if s.pushing then pc = pc + 1 end end
        for i, state in ipairs(activeBulges) do
            if state.weld and state.weld.Parent and state.part and state.part.Parent then
                local frac
                if state.pushing then
                    local p = (now - state.pushStartTime) / state.pushDuration
                    if p >= 1 then
                        state.pushing = false; pc = pc - 1
                        state.nextPushTime = now + CONFIG.nom.bulgeIdleMin + math.random() * (CONFIG.nom.bulgeIdleMax - CONFIG.nom.bulgeIdleMin)
                        frac = CONFIG.nom.bulgeIdleFrac
                    else
                        local arc = math.sin(p * math.pi)
                        frac = CONFIG.nom.bulgeIdleFrac + (CONFIG.nom.bulgePushFrac - CONFIG.nom.bulgeIdleFrac) * arc
                    end
                else
                    frac = CONFIG.nom.bulgeIdleFrac
                    if now >= state.nextPushTime then
                        if pc < CONFIG.nom.bulgeMaxConcurrent then
                            state.pushing = true; state.pushStartTime = now
                            state.pushDuration = CONFIG.nom.bulgePushMin + math.random() * (CONFIG.nom.bulgePushMax - CONFIG.nom.bulgePushMin)
                            pc = pc + 1
                        else
                            state.nextPushTime = now + 0.3 + math.random() * 0.5
                        end
                    end
                end
                local dx = math.sin(state.theta) * math.cos(state.phi)
                local dy = math.sin(state.phi)
                local dz = -math.cos(state.theta) * math.cos(state.phi)
                state.weld.C0 = CFrame.new(Vector3.new(dx*hx, dy*hy, dz*hz) * frac)
            end
        end
    end)
end

local function growBellyToLevel(character, popIn)
    local info
    if popIn then
        info = TweenInfo.new(CONFIG.nom.bellyPopInTime, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    else
        info = TweenInfo.new(CONFIG.nom.growTweenTime, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end
    local targets = computeBellyTargetsForLevel(nomLevel)
    for idx, layer in ipairs(activeBellyLayers) do
        local target = targets[idx]
        if target then
            if layer.mesh and layer.mesh.Parent then
                TweenService:Create(layer.mesh, info, {Scale = target.scale}):Play()
            end
            if layer.baseValue and layer.baseValue.Parent then
                TweenService:Create(layer.baseValue, info, {Value = target.c0}):Play()
            end
        end
    end
end

local function applyBellyGain(character, sc, gain)
    local isFirst = not bellyActive
    if isFirst then
        nomLevel = gain
        createNomBelly(character, sc)
        bellyActive = true
        growBellyToLevel(character, true)
        addBulgesForCurrentLevel(character, sc)
        startBulgeLoop(character)
        startBurpLoop(character)
    else
        nomLevel = nomLevel + gain
        growBellyToLevel(character, false)
        addBulgesForCurrentLevel(character, sc)
    end
end

-- ============================ NOM SEQUENCE (dummy) ============================
local function runNomSequence(character)
    if not character or not character.Parent then return end
    if isNomming or isDigesting then return end
    isNomming = true
    local head = character:FindFirstChild("Head")
    local ut = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    local lt = character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso")
    if not head or not ut or not lt then isNomming = false; return end
    local sc = getHeadColor(character)

    local dummy = buildNomDummy()
    nomModel = dummy
    setDummyCFrame(dummy, head.CFrame * CFrame.new(0, CONFIG.nom.spawnHeight, 0))

    local fallT = 0
    while fallT < CONFIG.nom.fallDuration do
        local dt = RunService.Heartbeat:Wait()
        fallT = fallT + dt
        if not dummy.Parent or not character.Parent then break end
        local h = character:FindFirstChild("Head")
        if not h then break end
        local a = math.clamp(fallT / CONFIG.nom.fallDuration, 0, 1)
        a = a * a
        local startCF = h.CFrame * CFrame.new(0, CONFIG.nom.spawnHeight, 0)
        local endCF = h.CFrame * CFrame.new(0, -0.3, -0.6)
        local pos = startCF.Position:Lerp(endCF.Position, a)
        setDummyCFrame(dummy, CFrame.new(pos) * CFrame.Angles(math.rad(a * 180), math.rad(180), 0))
    end

    if dummy.Parent then
        local shrinkT = 0
        while shrinkT < 0.20 do
            local dt = RunService.Heartbeat:Wait()
            shrinkT = shrinkT + dt
            if not dummy.Parent or not character.Parent then break end
            local h = character:FindFirstChild("Head")
            if not h then break end
            local a = math.clamp(shrinkT / 0.20, 0, 1)
            local mouthPos = h.Position + Vector3.new(0, -0.4, -0.6)
            setDummyCFrame(dummy, CFrame.new(dummy.PrimaryPart.Position:Lerp(mouthPos, a)))
            setDummyScale(dummy, 1 - a * 0.95)
            setDummyTransparency(dummy, a * 0.9)
        end
        dummy:Destroy()
        nomModel = nil
    end

    local throat = Instance.new("Part")
    throat.Name = "NomThroatBulge"; throat.Size = Vector3.new(1,1,1)
    throat.BrickColor = sc; throat.Material = Enum.Material.SmoothPlastic
    throat.Anchored = true; throat.CanCollide = false; throat.Parent = character
    local tm = Instance.new("SpecialMesh")
    tm.MeshType = Enum.MeshType.Sphere; tm.Scale = Vector3.new(0.85, 1.25, 0.85); tm.Parent = throat
    table.insert(nomTempParts, throat)

    local travelT = 0
    while travelT < CONFIG.nom.throatTravelTime do
        local dt = RunService.Heartbeat:Wait()
        travelT = travelT + dt
        if not character.Parent then break end
        local h = character:FindFirstChild("Head")
        local u2 = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
        local l2 = character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso")
        if not h or not u2 or not l2 then break end
        local a = math.clamp(travelT / CONFIG.nom.throatTravelTime, 0, 1)
        local p1 = (h.CFrame * CFrame.new(0, -0.6, -0.5)).Position
        local p2 = (u2.CFrame * CFrame.new(0, 0, -0.7)).Position
        local p3 = (l2.CFrame * CFrame.new(0, -0.4, -0.9)).Position
        local pos = (a < 0.5) and p1:Lerp(p2, a/0.5) or p2:Lerp(p3, (a-0.5)/0.5)
        throat.CFrame = CFrame.new(pos)
        throat.Transparency = math.max(0, 1 - a * 4)
    end
    throat:Destroy()

    applyBellyGain(character, sc, 1)
    isNomming = false
end

-- ============================ EAT ANYTHING — helpers ============================
local function getBoundsSize(obj)
    if obj:IsA("Model") then
        local ok, ext = pcall(function() return obj:GetExtentsSize() end)
        if ok and ext then return ext end
    end
    if obj:IsA("BasePart") then
        return obj.Size
    end
    -- Fallback: bounding box over descendants
    local minP, maxP = nil, nil
    for _, p in pairs(obj:GetDescendants()) do
        if p:IsA("BasePart") then
            local pos = p.Position
            local half = p.Size / 2
            local lo = pos - half
            local hi = pos + half
            if not minP then
                minP, maxP = lo, hi
            else
                minP = Vector3.new(math.min(minP.X, lo.X), math.min(minP.Y, lo.Y), math.min(minP.Z, lo.Z))
                maxP = Vector3.new(math.max(maxP.X, hi.X), math.max(maxP.Y, hi.Y), math.max(maxP.Z, hi.Z))
            end
        end
    end
    if minP and maxP then return maxP - minP end
    return Vector3.new(1,1,1)
end

local function computeLevelGain(obj)
    local ext = getBoundsSize(obj)
    local diag = ext.Magnitude
    local gain = math.clamp(math.floor(diag / CONFIG.nom.selectMode.sizeDivisor),
        CONFIG.nom.selectMode.minGain, CONFIG.nom.selectMode.maxGain)
    return gain, diag
end

local function findEatTarget(hit)
    if not hit then return nil end
    if hit:IsA("Terrain") then return nil end

    -- Walk up looking for a Model, but stop before workspace children that are huge containers
    local current = hit
    local bestModel = nil
    while current and current.Parent do
        if current:IsA("Model") then
            bestModel = current
        end
        if current.Parent == workspace then
            break
        end
        current = current.Parent
    end

    if bestModel then return bestModel end
    return hit
end

local function findEatTargetAtScreen(x, y)
    if not camera then return nil end
    local ray = camera:ViewportPointToRay(x, y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {player.Character}
    local result = workspace:Raycast(ray.Origin, ray.Direction * CONFIG.nom.selectMode.maxDistance, params)
    if not result then return nil end
    return findEatTarget(result.Instance)
end

