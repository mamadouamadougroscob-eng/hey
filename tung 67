-- ============================ JIGGLE ============================
local function startJiggle(character)
    if jiggleConn then jiggleConn:Disconnect() end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    jiggleTime = 0; landingEnergy = 0; wasOnGround = true
    jiggleConn = RunService.Heartbeat:Connect(function(dt)
        if not character.Parent then
            if jiggleConn then jiggleConn:Disconnect() end
            jiggleConn = nil; return
        end
        if isDigesting then return end

        jiggleTime = jiggleTime + dt
        local speed = humanoid and humanoid.MoveDirection.Magnitude or 0
        local isRunning = speed > 0.6
        if humanoid then
            local onGround = humanoid.FloorMaterial ~= Enum.Material.Air
            if onGround and not wasOnGround then landingEnergy = CONFIG.jiggle.landingAmplitude end
            wasOnGround = onGround
        end
        landingEnergy = landingEnergy * math.exp(-CONFIG.jiggle.landingDecay * dt)
        if landingEnergy < 0.001 then landingEnergy = 0 end
        local walkMult = isRunning and CONFIG.jiggle.runMultiplier or 1
        local walkBounce = math.abs(math.sin(jiggleTime * CONFIG.jiggle.walkSpeed))
            * CONFIG.jiggle.walkAmplitude * (speed>0.1 and 1 or 0) * walkMult
        local idleBounce = math.sin(jiggleTime * CONFIG.jiggle.idleSpeed) * CONFIG.jiggle.idleAmplitude
        local totalBounce = walkBounce + idleBounce + landingEnergy
        local sway = math.sin(jiggleTime * CONFIG.jiggle.walkSpeed * 0.5)
            * CONFIG.jiggle.walkAmplitude * 0.4 * (speed>0.1 and 1 or 0)
        local bellyWalk = math.abs(math.sin(jiggleTime * CONFIG.jiggle.walkSpeed + math.pi*0.3))
            * CONFIG.jiggle.bellyWalkAmplitude * (speed>0.1 and 1 or 0) * walkMult
        local bellyIdle = math.sin(jiggleTime * CONFIG.jiggle.bellyIdleSpeed) * CONFIG.jiggle.bellyIdleAmplitude
        local bellySag = -landingEnergy * CONFIG.jiggle.bellyLandingSag
        local bellyPush = -landingEnergy * CONFIG.jiggle.bellyLandingPushZ
        for _, entry in pairs(jiggleParts) do
            if entry.part and entry.part.Parent and entry.weld and entry.weld.Parent then
                if entry.group == "belly" then
                    local idx = entry.bellyIndex or 1
                    local phase = (idx - 1) * CONFIG.jiggle.bellyPhaseSpread
                    local amp = (idx==1 and 0.7) or (idx==2 and 1.15) or (idx==3 and 0.85) or 0.9
                    local gb = (bellyWalk*amp + bellyIdle*amp + bellySag*amp)
                    if speed > 0.1 then
                        gb = gb + math.sin(jiggleTime * CONFIG.jiggle.walkSpeed + phase) * 0.04 * (speed>0.5 and 1.4 or 1)
                    end
                    local baseVec = entry.baseValue and entry.baseValue.Value or Vector3.new(0,0,0)
                    entry.weld.C0 = CFrame.new(baseVec + Vector3.new(0, gb, bellyPush*amp))
                else
                    local isGlute = string.sub(entry.group, 1, 5) == "glute"
                    local sideSign = string.sub(entry.group, -1) == "R" and 1 or -1
                    local phase = isGlute and CONFIG.jiggle.phaseOffset or 0
                    local mult = isGlute and CONFIG.jiggle.gluteOffset or 1
                    local gb = totalBounce * mult
                    if phase ~= 0 and speed > 0.1 then
                        gb = gb * 0.6 + math.abs(math.sin(jiggleTime * CONFIG.jiggle.walkSpeed + phase))
                            * CONFIG.jiggle.walkAmplitude * mult * (isRunning and CONFIG.jiggle.runMultiplier or 1)
                    end
                    entry.weld.C0 = entry.baseC0 + Vector3.new(sway * sideSign * 0.5, gb, 0)
                end
            end
        end
    end)
end

local function stopJiggle()
    if jiggleConn then jiggleConn:Disconnect(); jiggleConn = nil end
    jiggleParts = {}; jiggleTime = 0; landingEnergy = 0
end

local function clearAll(character)
    stopJiggle()
    for _, p in pairs(createdParts) do if p and p.Parent then p:Destroy() end end
    createdParts = {}
    bodyMeshRefs = {}
    if character then restoreRigColors() end
end

local function buildAll(character)
    if not character or not character.Parent then return end
    clearAll(character)
    local ut = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    local lt = character:FindFirstChild("LowerTorso") or character:FindFirstChild("Torso")
    if not ut or not lt then return end

    setCharacterScale(character, getPlayerScale(currentBodyGrowth))
    task.wait(0.05)

    recolorRig(character)
    local sc = getHeadColor(character)
    buildBreast(ut, sc); buildGlute(lt, sc); buildThigh(character, sc); buildSlit(lt, sc)
    startJiggle(character)
    startHipSpread(character)
end

