    if not head then return nil end
    for _, d in pairs(character:GetDescendants()) do
        if d:IsA("Motor6D") and (d.Name == "Neck" or d.Name == "RootJoint") then
            if d.Part1 == head then return d end
        end
    end
    return nil
end

